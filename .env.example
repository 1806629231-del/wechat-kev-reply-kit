# 复制成 /workspace/wxauto/.env ，chmod 600。密钥只用密钥输入框收，不要在聊天里发。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=<在这里填你的 API Key>
LLM_MODEL=deepseek-chat
# 机器人在微信里的昵称（被 @ 时识别用），多个别名用英文逗号
BOT_NICK=<机器人微信昵称>
BOT_ALIASES=<机器人微信昵称>,<群昵称>
# 主人昵称（私聊时认出主人）
OWNER_NICK=<主人微信昵称>
# 机器人所在、允许回复的群（英文逗号分隔）
WX_GROUPS=<群名1>,<群名2>
# kev 本地判断服务
KEV_URL=http://127.0.0.1:8009
# 1=用 weflow 读本地消息库（推荐），0=退回截屏 OCR
WEFLOW_READ=1
